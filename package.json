{
  "name": "portfolio-v9",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm content:generate && react-router typegen && tsc -b && react-router build && node tools/finalize-build.ts && node tools/verify-build.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "clean": "biome format --write && biome lint --write",
    "content:generate": "node tools/generate-articles.ts",
    "coverage": "pnpm content:generate && vitest run --coverage",
    "dev": "pnpm content:generate && react-router dev",
    "format": "biome format",
    "format:write": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "preview": "vite preview --outDir dist/client",
    "test": "pnpm content:generate && vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "clsx": "^2.1.1",
    "fast-shuffle": "^7.0.0",
    "framer-motion": "14.13.0",
    "jotai": "^3.0.2",
    "liquid-gooey": "0.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "react-shiki": "^0.11.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "2.6.7",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "8.5.1",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "github-slugger": "2.0.0",
    "happy-dom": "^21.0.4",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "ultracite": "8.2.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.0"
  }
}
