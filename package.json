{
  "name": "my-fav-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm content:generate && react-router typegen && tsc -b && react-router build && node tools/finalize-build.ts && node tools/verify-build.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "clean": "biome format --write && biome lint --write",
    "content:generate": "node tools/generate-articles.ts",
    "coverage": "pnpm content:generate && vitest run --coverage",
    "dev": "pnpm content:generate && react-router dev",
    "format": "biome format",
    "format:write": "biome format --write",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "preview": "vite preview --outDir dist/client",
    "test": "pnpm content:generate && vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-shuffle": "^6.2.1",
    "framer-motion": "^13.4.4",
    "isbot": "^5.2.2",
    "jotai": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "react-shiki": "^0.11.1",
    "react-zoom-pan-pinch": "^4.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "2.5.14",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "github-slugger": "2.0.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "ultracite": "7.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b",
  "engines": {
    "node": ">=22.22.0"
  }
}
